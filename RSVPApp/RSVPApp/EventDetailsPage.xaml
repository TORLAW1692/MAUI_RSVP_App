<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RSVPApp.EventDetailsPage"
    Title="Event Details"
    BackgroundColor="#0B0B0D">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12">

            <!-- Event name comes from the selected Event object -->
            <Label
                Text="{Binding EventName}"
                FontSize="22"
                TextColor="White"
                FontAttributes="Bold" />

            <!-- Event information -->
            <Border
                BackgroundColor="#121214"
                Stroke="#2A2A2E"
                StrokeThickness="1"
                Padding="12">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label
                        x:Name="HostLabel"
                        TextColor="#D0D0D0" />

                    <Label
                        Text="{Binding EventAddress, StringFormat='Address: {0}'}"
                        TextColor="#D0D0D0" />

                    <Label
                        Text="{Binding MaximumAllowedAttendees, StringFormat='Maximum Attendees: {0}'}"
                        TextColor="#D0D0D0" />

                    <Label
                        x:Name="AttendeeCountLabel"
                        TextColor="#D0D0D0" />

                    <Label
                        Text="{Binding EventDateTime, StringFormat='Event: {0:ddd, MMM d - h:mm tt}'}"
                        TextColor="#D0D0D0" />

                    <Label
                        Text="{Binding RSVPDeadline, StringFormat='RSVP Deadline: {0:ddd, MMM d - h:mm tt}'}"
                        TextColor="#D0D0D0" />

                </VerticalStackLayout>

            </Border>

            <BoxView
                HeightRequest="1"
                Color="#222222" />

            <Label
                Text="RSVP"
                FontSize="18"
                TextColor="White"
                FontAttributes="Bold" />

            <!-- Logged-in users will have these fields prepopulated -->
            <Entry
                x:Name="RsvpNameEntry"
                Placeholder="Name"
                PlaceholderColor="#9EA0A4"
                BackgroundColor="#121214"
                TextColor="White" />

            <Entry
                x:Name="RsvpEmailEntry"
                Placeholder="Email Address"
                PlaceholderColor="#9EA0A4"
                Keyboard="Email"
                BackgroundColor="#121214"
                TextColor="White" />

            <Entry
                x:Name="RsvpPhoneEntry"
                Placeholder="Mobile Phone Number"
                PlaceholderColor="#9EA0A4"
                Keyboard="Telephone"
                BackgroundColor="#121214"
                TextColor="White" />

            <HorizontalStackLayout
                Spacing="12"
                Padding="0,6,0,0">

                <Button
                    x:Name="RsvpButton"
                    Text="RSVP"
                    BackgroundColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnRsvpClicked" />

                <Button
                    x:Name="CancelButton"
                    Text="Cancel"
                    BackgroundColor="Transparent"
                    BorderColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8"
                    Clicked="OnCancelClicked" />

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
