<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPApp.EventDetailsPage"
             Title="Event Details"
             BackgroundColor="#0B0B0D">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12">

            <Label Text="Community Potluck" FontSize="22" TextColor="White" FontAttributes="Bold" />

            <Frame BackgroundColor="#121214" CornerRadius="8" HasShadow="False">
                <VerticalStackLayout Padding="12" Spacing="6">
                    <Label Text="Host: Jane Doe" TextColor="#D0D0D0" />
                    <Label Text="Address: Community Hall, 123 Main St" TextColor="#D0D0D0" />
                    <Label Text="Maximum Attendees: 100" TextColor="#D0D0D0" />
                    <Label Text="Current Attendance: 24" TextColor="#D0D0D0" />
                    <Label Text="Event: Sat, Oct 2 · 6:00 PM" TextColor="#D0D0D0" />
                    <Label Text="RSVP Deadline: Fri, Sep 24 · 11:59 PM" TextColor="#D0D0D0" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Attendees" FontSize="16" TextColor="White" FontAttributes="Bold" />
            <VerticalStackLayout BackgroundColor="#0B0B0D" Spacing="6">
                <Label Text="- Alice Smith" TextColor="#C0C0C0" />
                <Label Text="- Bob Johnson" TextColor="#C0C0C0" />
                <Label Text="- Carol Nguyen" TextColor="#C0C0C0" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#222" />

            <Label Text="RSVP" FontSize="18" TextColor="White" FontAttributes="Bold" />

            <Entry x:Name="RsvpNameEntry" Placeholder="Name" PlaceholderColor="#9EA0A4" BackgroundColor="#121214" TextColor="White" />
            <Entry x:Name="RsvpEmailEntry" Placeholder="Email Address" PlaceholderColor="#9EA0A4" Keyboard="Email" BackgroundColor="#121214" TextColor="White" />
            <Entry x:Name="RsvpPhoneEntry" Placeholder="Mobile Phone Number" PlaceholderColor="#9EA0A4" Keyboard="Telephone" BackgroundColor="#121214" TextColor="White" />

            <HorizontalStackLayout Spacing="12" Padding="0,6,0,0">
                <Button x:Name="RsvpButton" Text="RSVP" BackgroundColor="#0A3B78" TextColor="White" CornerRadius="8" HorizontalOptions="FillAndExpand" Clicked="OnRsvpClicked" />
                <Button x:Name="CancelButton" Text="Cancel" BackgroundColor="Transparent" BorderColor="#0A3B78" TextColor="White" CornerRadius="8" HorizontalOptions="Fill" Clicked="OnCancelClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
