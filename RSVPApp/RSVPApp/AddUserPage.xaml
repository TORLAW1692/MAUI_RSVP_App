<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPApp.AddUserPage"
             Title="Create account"
             BackgroundColor="#0B0B0D">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="14"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <Label
                Text="Create account"
                FontSize="22"
                TextColor="White"
                HorizontalOptions="Center" />

            <Entry
                x:Name="NameEntry"
                Placeholder="Name"
                PlaceholderColor="#9EA0A4"
                HorizontalOptions="Fill"
                BackgroundColor="#121214"
                TextColor="White" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email Address"
                PlaceholderColor="#9EA0A4"
                Keyboard="Email"
                HorizontalOptions="Fill"
                BackgroundColor="#121214"
                TextColor="White" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                PlaceholderColor="#9EA0A4"
                IsPassword="True"
                HorizontalOptions="Fill"
                BackgroundColor="#121214"
                TextColor="White" />

            <Entry
                x:Name="PhoneEntry"
                Placeholder="Mobile Phone Number"
                PlaceholderColor="#9EA0A4"
                Keyboard="Telephone"
                HorizontalOptions="Fill"
                BackgroundColor="#121214"
                TextColor="White" />

            <HorizontalStackLayout
                HorizontalOptions="Fill"
                Spacing="12"
                Padding="0,8,0,0">
                <Button
                    x:Name="OkButton"
                    Text="OK"
                    Clicked="OnOkClicked"
                    BackgroundColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    HeightRequest="46" />
                <Button
                    x:Name="CancelButton"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    BorderColor="#0A3B78"
                    BorderWidth="1"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    HeightRequest="46" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
