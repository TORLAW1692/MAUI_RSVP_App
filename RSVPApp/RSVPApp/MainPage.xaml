<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVPApp.MainPage"
             BackgroundColor="#0B0B0D">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <Label
                Text="RSVP App"
                FontSize="28"
                HorizontalOptions="Center"
                TextColor="White"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Sign in to continue"
                FontSize="14"
                TextColor="#D0D0D0"
                HorizontalOptions="Center" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                PlaceholderColor="#9EA0A4"
                Keyboard="Email"
                ClearButtonVisibility="WhileEditing"
                HorizontalOptions="Fill"
                BackgroundColor="#121214"
                TextColor="White"
                AutomationId="emailEntry" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                PlaceholderColor="#9EA0A4"
                IsPassword="True"
                ClearButtonVisibility="WhileEditing"
                HorizontalOptions="Fill"
                BackgroundColor="#121214"
                TextColor="White"
                AutomationId="passwordEntry" />

            <Button
                x:Name="LoginButton"
                Text="Log in"
                Clicked="OnLoginClicked"
                HorizontalOptions="Fill"
                Margin="0,6,0,0"
                BackgroundColor="#0A3B78"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="46" />

            <Button
                x:Name="GuestButton"
                Text="Continue as Guest"
                Clicked="OnGuestLoginClicked"
                BackgroundColor="Transparent"
                BorderColor="#0A3B78"
                BorderWidth="1"
                TextColor="White"
                HorizontalOptions="Fill"
                CornerRadius="8"
                HeightRequest="46" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="6"
                Padding="0,8,0,0">
                <Label
                    Text="Don't have an account?"
                    VerticalOptions="Center"
                    TextColor="White" />
                <Button
                    Text="Create one"
                    Clicked="OnCreateAccountClicked"
                    BackgroundColor="Transparent"
                    TextColor="#0A3B78"
                    Padding="0"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
