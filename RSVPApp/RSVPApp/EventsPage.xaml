<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RSVPApp.Models"
    x:Class="RSVPApp.EventsPage"
    Title="Events"
    BackgroundColor="#08080D">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="12">

            <Label
                Text="Events"
                FontSize="26"
                TextColor="White"
                HorizontalOptions="Start" />

            <!-- Filter controls -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Fill">
                <Button
                    x:Name="AllEventsButton"
                    Text="All Events"
                    Clicked="OnAllEventsClicked"
                    BackgroundColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8" />

                <Button
                    x:Name="AttendingButton"
                    Text="Attending"
                    Clicked="OnAttendingClicked"
                    BackgroundColor="Transparent"
                    BorderColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8" />

                <Button
                    x:Name="HostingButton"
                    Text="Hosting"
                    Clicked="OnHostingClicked"
                    BackgroundColor="Transparent"
                    BorderColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8" />
            </HorizontalStackLayout>

            <!-- Events list -->
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding DisplayedEvents}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Event">
                        <Border
                            BackgroundColor="#121214"
                            Stroke="#2A2A2E"
                            StrokeThickness="1"
                            Padding="12">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnEventTapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding EventName}"
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    TextColor="White" />

                                <Label
                                    Text="{Binding EventDateTime, StringFormat='{0:ddd, MMM d - h:mm tt}'}"
                                    FontSize="12"
                                    TextColor="#D0D0D0" />

                                <Label
                                    Text="{Binding EventAddress}"
                                    FontSize="12"
                                    TextColor="#ACBCC0" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <!-- Actions -->
            <HorizontalStackLayout Spacing="12" Padding="0,8,0,0">
                <Button
                    x:Name="AddEventButton"
                    Text="Add Event"
                    BackgroundColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    Clicked="OnAddEventClicked" />

                <Button
                    x:Name="LogoutButton"
                    Text="Log Out"
                    BackgroundColor="Transparent"
                    BorderColor="#0A3B78"
                    TextColor="White"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    Clicked="OnLogoutClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
